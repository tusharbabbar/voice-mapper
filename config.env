# Settings shared by the scripts. Override any of them on the command line, e.g.
#   EPOCHS=60 ./scripts/train.sh

# Name of your voice. Used for the dataset folder and the checkpoint folder.
VOICE_NAME=myvoice

# Where your LJSpeech dataset (metadata.csv + wavs/) lives on the GPU machine.
DATASET_DIR=/workspace/voice_dataset

# Where F5-TTS gets cloned on the GPU machine.
F5_DIR=/workspace/F5-TTS

# Training. These defaults suit ~30-90 min of speech on one 24 GB GPU (RTX 4090 / 3090 / A5000).
# BATCH_FRAMES: audio frames per batch (~94 frames per second of audio). Lower it if you run out of GPU memory.
BATCH_FRAMES=6400
LEARNING_RATE=1e-5
EPOCHS=80
WARMUP_UPDATES=500
SAVE_EVERY=1000
LAST_EVERY=250
KEEP_LAST=5
